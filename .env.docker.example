# 复制为 .env 后再执行 docker compose up -d
# cp .env.docker.example .env

ADMIN_PASSWORD=change-me-admin-password
DEFAULT_USER_PASSWORD=change-me-default-password
ENCRYPT_KEY=change-me-encrypt-key

# 可选：会话/备份策略
SESSION_TTL_HOURS=8
REMEMBER_SESSION_TTL_DAYS=30
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=10

# 可选：secure profile（HTTPS 网关）证书配置
TLS_DOMAINS=localhost 127.0.0.1 your-host.local
TLS_CERT_DAYS=825
